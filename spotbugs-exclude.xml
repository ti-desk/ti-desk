<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Excluir clases generadas o DTOs si es necesario -->
    <Match>
        <Package name="~mx\.edu\.tidesk\.ti_desk\..*\.dto.*" />
    </Match>
    <!-- Excluir getters/setters JPA con listas modificables -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
</FindBugsFilter>